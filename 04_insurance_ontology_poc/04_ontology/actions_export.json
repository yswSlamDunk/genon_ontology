    "name": "current",
    "title": "심사 시스템 청구 조회 (현재 평가 ID)",
    "system": "ins-review",
    "operation_id": "getClaim",
    "compensable": false
   },
   {
    "name": "approve",
    "title": "심사 시스템 지급 승인",
    "system": "ins-review",
    "operation_id": "approveClaim",
    "compensable": false
   }
  ]
