[
 {
  "class": "Document",
  "action": "verifyDocument",
  "description": "증빙 서류를 확인 처리한다(A03, 심사 시스템 verifyEvidence). 확인값(피보험자 청구인 번호·의료기관·입원일·퇴원일)과 근거를 기록한다 — 추출값이 아닌 심사자 확인값. 되돌리는 API 가 없어 보상하지 않는다(정정은 다시 확인 처리). writeback 없음(응답 status 는 서류 노드의 값이 아니다). 실행 후 getDocumentVerification 으로 DocumentVerification 을 다시 적재한다. 실행자는 담당 심사자 actor_id. 정책: scm_operator.",
  "parameters": {
   "type": "object",
   "properties": {
    "actor_id": {
     "type": "string",
     "description": "담당 심사자 ID (예: reviewer-01)"
    },
    "verification_status": {
     "type": "string",
     "enum": [
      "VERIFIED",
      "REJECTED"
     ],
     "description": "확인 완료=VERIFIED"
    },
    "insured": {
     "type": "string",
     "description": "확인값 피보험자 청구인 번호 (예: IP-0002)"
    },
    "provider_code": {
     "type": "string",
     "description": "확인값 의료기관 (예: H-001)"
    },
    "admission_date": {
     "type": "string",
     "format": "date",
     "description": "확인값 입원일"
    },
    "discharge_date": {
     "type": "string",
     "format": "date",
     "description": "확인값 퇴원일"
    },
    "note": {
     "type": "string",
     "description": "확인 근거 (예: 원본 대조)"
    }
   },
   "required": [
    "actor_id",
    "verification_status",
    "insured",
    "provider_code",
    "admission_date",
    "discharge_date",
    "note"
   ]
  },
  "effect": "write",
  "confirm_threshold": 1,
  "max_targets": 1,
  "key_property": "doc_id",
  "system": "ins-review",
  "operation_id": "verifyEvidence",
  "steps": [
   {
    "name": "review",
    "title": "심사 시스템 증빙 확인",
